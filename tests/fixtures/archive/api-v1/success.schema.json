{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "results"
  ],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "year",
          "imdbUrl",
          "posterUrl"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "imdbUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://www\\.imdb\\.com/title/tt[0-9]+/$"
          },
          "posterUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
