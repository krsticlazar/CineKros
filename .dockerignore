# Start with an empty context. Only the API and its declared project references
# are re-included below; the database, frontend, research, thesis and local
# coordination trees never enter the Docker build context.
**

!global.json
!Directory.Build.props

!src/
!src/backend/
!src/backend/CineKros.Api/
!src/backend/CineKros.Api/**
!src/embedding/
!src/embedding/CineKros.Embedding/
!src/embedding/CineKros.Embedding/**
!src/etl/
!src/etl/CineKros.Catalog.Importer/
!src/etl/CineKros.Catalog.Importer/**
!src/shared/
!src/shared/CineKros.TextNormalization/
!src/shared/CineKros.TextNormalization/**

!deploy/
!deploy/Dockerfile.api
!deploy/start-api.sh
!deploy/locks/
!deploy/locks/api/
!deploy/locks/api/packages.lock.json
!deploy/locks/embedding/
!deploy/locks/embedding/packages.lock.json
!deploy/locks/importer/
!deploy/locks/importer/packages.lock.json

# Keep local state and generated output excluded even if it appears inside an
# allowed project directory.
**/bin
**/bin/**
**/obj
**/obj/**
**/.local
**/.local/**
**/.git
**/.git/**
**/dist
**/dist/**
**/*.log
**/*.zip
**/*.aar
**/node_modules
**/node_modules/**
**/.env
**/.env.*
**/secrets/**
**/.secrets/**
**/credentials/**
**/*credentials*.json
**/service-account*.json
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/appsettings*.json
!src/backend/CineKros.Api/appsettings.json
!src/backend/CineKros.Api/appsettings.Development.json
**/launchSettings.json
**/README.md
**/*.user
**/*.onnx
**/*.dump
**/*.backup
**/*.dll
**/*.pdb
**/*.csv
**/*.tsv
**/*.jsonl
